<Window x:Class="AgentHud.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Agent HUD"
        Width="372"
        Height="78"
        MinWidth="372"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="QuietButton" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#D7DCE3" />
            <Setter Property="Background" Value="#16FFFFFF" />
            <Setter Property="BorderBrush" Value="#20FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface"
                                CornerRadius="18"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell"
            CornerRadius="26"
            Background="#F21D2025"
            BorderBrush="#24FFFFFF"
            BorderThickness="1"
            Padding="8"
            MouseLeftButtonDown="Shell_OnMouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28"
                              ShadowDepth="7"
                              Opacity="0.28" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="60" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="40" Height="40" VerticalAlignment="Center">
                    <Ellipse Fill="#EEF3F7" />
                    <TextBlock Text="A"
                               Foreground="#1A1D21"
                               FontWeight="SemiBold"
                               FontSize="16"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Ellipse Width="10"
                             Height="10"
                             Fill="#37B982"
                             Stroke="#1D2025"
                             StrokeThickness="2"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom" />
                </Grid>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Margin="12,0,12,0">
                    <TextBlock Text="Agent HUD"
                               FontSize="14"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SummaryText}"
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="#AEB7C3"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="2"
                        x:Name="ExpandButton"
                        Style="{StaticResource QuietButton}"
                        Content="⌄"
                        ToolTip="Expand agent sessions"
                        Click="ExpandButton_OnClick" />
            </Grid>

            <Border Grid.Row="1"
                    x:Name="DetailsPanel"
                    Visibility="Collapsed"
                    BorderBrush="#1FFFFFFF"
                    BorderThickness="0,1,0,0"
                    Margin="4,2,4,0"
                    Padding="4,14,4,4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Agent sessions"
                                       FontSize="17"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Local monitor · read-only"
                                       Margin="0,3,0,0"
                                       FontSize="11"
                                       Foreground="#8F99A6" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Padding="10,5"
                                CornerRadius="11"
                                VerticalAlignment="Center"
                                Background="#14FFFFFF">
                            <TextBlock Text="{Binding AttentionText}"
                                       FontSize="11"
                                       Foreground="#BCC4CE" />
                        </Border>
                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Sessions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9"
                                            Padding="12"
                                            CornerRadius="16"
                                            Background="#0DFFFFFF"
                                            BorderBrush="#18FFFFFF"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="40" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="34"
                                                    Height="34"
                                                    CornerRadius="11"
                                                    Background="{Binding ProviderBrush}"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding ProviderInitial}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="13" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding ProviderName}"
                                                                   Margin="0,2,0,0"
                                                                   FontSize="11"
                                                                   Foreground="#929CA8" />
                                                    </StackPanel>

                                                    <Border Grid.Column="1"
                                                            Padding="8,4"
                                                            CornerRadius="10"
                                                            Background="#10FFFFFF"
                                                            VerticalAlignment="Top">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7"
                                                                     Height="7"
                                                                     Margin="0,0,6,0"
                                                                     Fill="{Binding StatusBrush}"
                                                                     VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding StateLabel}"
                                                                       FontSize="10"
                                                                       Foreground="#CDD3DB" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>

                                                <TextBlock Text="{Binding StatusText}"
                                                           Margin="0,10,0,0"
                                                           FontSize="12"
                                                           Foreground="#D4D8DE"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding UsageText}"
                                                           Margin="0,4,0,0"
                                                           FontSize="10"
                                                           Foreground="#788390" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2"
                               Margin="2,8,2,2"
                               Text="Codex local discovery enabled · quota, approvals and Claude are next."
                               FontSize="10"
                               Foreground="#737E8B"
                               HorizontalAlignment="Center" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
